# Patch Provider
# Manual patch mode: create patch.diff with Claude Code / Skill and point PATCH_FILE to it.
PATCH_FILE=/absolute/path/to/patch.diff
PATCH_TOOL_NAME=claude_code
PATCH_SKILL_NAME=patch-generate
OPERATOR_NAME=your-name

# Optional API fallback
OPENAI_API_KEY=sk-xxx

# CoppeliaSim
COPPELIASIM_HOST=127.0.0.1
COPPELIASIM_PORT=23000
COPPELIASIM_DEFAULT_SCENE_PATH=/absolute/path/on/coppeliasim-host/default_drone.ttt

# Repo
REPO_URL=/absolute/path/to/repo-or-git-url
BASE_REF=<commit-sha>
